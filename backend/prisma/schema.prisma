// NextPM Adaptive — PostgreSQL schema
// Hierarchy: Program -> Project workspace (a project with no program is standalone)
// Planning flow: Input & verify -> Governance recommendation -> Template, generate & approve
//
// Governance model recommendation is LLM-driven (see modules/ai/provider.ts,
// modules/rules/rules.service.ts — the module keeps its original folder name for a
// minimal diff, but no longer runs a deterministic rule engine).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

/// Global account role. Deliberately three, non-overlapping responsibilities:
/// ADMIN never touches delivery data, PROGRAM_OWNER is the only role that may create a Program,
/// and PROJECT_OWNER (what self-registration grants) may create projects but only open its own.
enum Role {
  ADMIN
  PROGRAM_OWNER
  PROJECT_OWNER
}

/// A user's role *inside* one project — separate from the account role on purpose, so granting
/// someone access to a workspace can never change what they may do platform-wide.
enum ProjectRole {
  OWNER
  MEMBER
  VIEWER
}

enum ProjectType {
  SI // System Integration
  SM // Service Management
  PRODUCT // Product Development
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  HOLD
  CLOSED
}

enum ManagementDomain {
  GOVERNANCE
  SCOPE
  SCHEDULE
  FINANCE
  STAKEHOLDERS
  RESOURCES
  RISK
  /// The full project plan workbook, filled from the house template. Its own tab because it is a
  /// single large deliverable that spans every other domain rather than sitting inside one.
  PROJECT_PLAN
  /// The kickoff deck is the one output produced by filling the customer's own file rather than
  /// by drafting prose, so it gets its own tab instead of hiding among the stakeholder documents.
  KICKOFF
}

enum FieldType {
  TEXT
  TEXTAREA
  DATE
  DATE_RANGE
  SELECT
  NUMBER
}

/// Where an input value came from. Files never become approved facts automatically:
/// they only ever produce FILE_REFERENCE / AI_SUGGESTED candidates awaiting PM confirmation.
enum InputSource {
  PM_INPUT
  FILE_REFERENCE
  AI_SUGGESTED
}

enum ReferenceGroup {
  COMMITMENT // SOW, proposal, RFP, contract excerpt
  SCOPE // requirement list, feature map, product brief
  ORGANIZATION // roster, stakeholder list, org chart
  SCHEDULE // committed dates, launch calendar, estimate
  OTHER // anything else about the project the PM wants the agent to read
  DESCRIPTION // free-form project description document, read for AI analysis
}

enum ReferenceStatus {
  UPLOADED
  CLASSIFYING
  VERIFIED
  WARNING
  FAILED
}

enum Requirement {
  REQUIRED
  CONDITIONAL
}

enum DocumentStatus {
  NOT_GENERATED
  GENERATING
  PM_REVIEW
  APPROVED
  SUPERSEDED
}

enum DecisionOutcome {
  CONFIRMED
  OVERRIDDEN
}

enum ActionPriority {
  REQUIRED
  CONDITIONAL
  INFO
}

enum ActionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TaskState {
  TODO
  REVIEW
  BLOCKED
  DONE
}

enum ActorType {
  PM
  AGENT
  SYSTEM
}

enum AgentRole {
  USER
  AGENT
}

// ---------------------------------------------------------------- identity

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  initials     String
  jobTitle     String   @default("Project Manager")
  role         Role     @default(PROJECT_OWNER)
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  ownedPrograms    Program[]
  ownedProjects    Project[]           @relation("projectOwner")
  agentSessions    AgentSession[]
  memberships      ProjectMember[]
  decisions        ApproachDecision[]
  approvedDocs     PlanningDocument[]  @relation("documentApprover")
  verifiedInputs   ProjectInputValue[] @relation("inputVerifier")
  auditEvents      AuditEvent[]
  dashboardLayouts DashboardLayout[]

  @@map("users")
}

// ---------------------------------------------------------------- hierarchy

model Program {
  id            String   @id @default(uuid())
  key           String   @unique // stable slug used by the UI (commerce, factory, services...)
  name          String
  description   String?
  targetOutcome String?
  colorKey      String   @default("blue") // blue | violet | green | orange
  ownerId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner    User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  projects Project[]

  @@map("programs")
}

model Project {
  id          String        @id @default(uuid())
  programId   String? // null => standalone project
  ownerId     String? // the project owner — the account that created it
  name        String
  type        ProjectType
  status      ProjectStatus @default(DRAFT)
  /// Free text, and the ONLY thing the customer library matches a project on. Set by the PM —
  /// never by extraction, which may only propose (see `customerSuggestion`).
  customer    String?
  /// The governance model the PM had already decided on before any analysis, chosen on Project
  /// Input. Null means "I don't know yet, recommend one" — and that null is what decides which of
  /// the two Planning Review modes runs, so it is a real answer rather than a missing one.
  ///
  /// Distinct from `ApproachDecision.approach`, which is the confirmed gate: this is only an
  /// intention, and the PM still confirms it on the Planning Review screen.
  preferredApproach String?
  /// A customer name Skill 0 read out of the uploaded documents, waiting for the PM to accept or
  /// dismiss it: `{ name, evidence, sourceLabel, matchedKey, matchedName, suggestedAt }`.
  /// Held separately from `customer` on purpose — the same rule as every other extraction in this
  /// system: a file produces a candidate, never an approved fact. Picking the wrong customer means
  /// scoring the project against the wrong checklist and filling another company's template, so
  /// this one is confirmed by a person.
  customerSuggestion Json?
  summary     String?
  phaseLabel  String?
  targetStart DateTime?
  targetEnd   DateTime?
  targetLabel String? // "Mar 31", "Q1 pilot", "Dec 31 renewal"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  program          Program?               @relation(fields: [programId], references: [id], onDelete: SetNull)
  owner            User?                  @relation("projectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  inputValues      ProjectInputValue[]
  customFields     ProjectCustomField[]
  references       ReferenceFile[]
  aiSuggestions    AiApproachSuggestion[]
  decisions        ApproachDecision[]
  documents        PlanningDocument[]
  actionItems      ActionItem[]
  tasks            PlanningTask[]
  domainReadiness  DomainReadiness[]
  auditEvents      AuditEvent[]
  agentMessages    AgentMessage[]
  agentSessions    AgentSession[]
  dashboardLayouts DashboardLayout[]
  exports          ExportJob[]
  /// How this project stands against its customer's checklist — see ProjectChecklistAssessment.
  checklistAssessments ProjectChecklistAssessment[]

  @@index([status])
  @@index([programId])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ---------------------------------------------------------------- flow 1: input & verify

/// Schema-driven minimum input profile, per project type. Seeded, editable by admins.
model InputFieldDefinition {
  id          String           @id @default(uuid())
  projectType ProjectType
  key         String
  label       String
  helpText    String?
  fieldType   FieldType        @default(TEXT)
  options     String[]         @default([])
  required    Boolean          @default(true)
  domain      ManagementDomain @default(GOVERNANCE)
  signalKey   String? // hook consumed by the recommendation prompt builder
  order       Int              @default(0)

  values ProjectInputValue[]

  @@unique([projectType, key])
  @@map("input_field_definitions")
}

model ProjectInputValue {
  id           String      @id @default(uuid())
  projectId    String
  definitionId String
  value        String?
  source       InputSource @default(PM_INPUT)
  verified     Boolean     @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  conflictNote String?
  updatedAt    DateTime    @updatedAt

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition InputFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  verifiedBy User?                @relation("inputVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([projectId, definitionId])
  @@map("project_input_values")
}

/// "Custom context" — extra PM signals that may feed the recommendation, document content, or both.
model ProjectCustomField {
  id        String   @id @default(uuid())
  projectId String
  name      String
  value     String?
  useIn     String   @default("BOTH") // RULES | DOCUMENT | BOTH
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_custom_fields")
}

model ReferenceFile {
  id             String          @id @default(uuid())
  projectId      String
  group          ReferenceGroup
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  status         ReferenceStatus @default(UPLOADED)
  verifiedFields Int             @default(0)
  message        String?
  extraction     Json? // candidate values / extracted text proposed for PM confirmation
  uploadedAt     DateTime        @default(now())

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiSuggestions AiApproachSuggestion[]

  @@index([projectId, group])
  @@map("reference_files")
}

// ---------------------------------------------------------------- flow 2: governance model recommendation

/// One LLM-generated governance-model recommendation snapshot. Immutable, like an
/// evaluation: it reads verified project inputs + the project description document
/// and returns a primary model, a 0-100 suitability score, reasons, evidence, risks
/// and scored alternatives. The PM decision gate (ApproachDecision) is what actually
/// commits to one — this table only ever proposes.
model AiApproachSuggestion {
  id                  String   @id @default(uuid())
  projectId           String
  sourceFileId        String?
  recommendedApproach String // governance model code, e.g. WATERFALL | SCRUM | KANBAN | HYBRID | ITERATIVE | STAGE_GATE | a custom AI-proposed label
  confidence          Int // 0-100 suitability score
  confidenceLevel      String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  rationale           String
  reasons             Json     @default("[]") // string[] — key reasons for the primary pick
  evidence            Json     @default("[]") // string[] — project evidence the reasons are grounded in
  risks               Json     @default("[]") // string[] — risks / limitations of the primary pick
  alternatives        Json     @default("[]") // [{ approach, score, rationale }]
  summary             String?
  candidateValues     Json     @default("[]")

  /// What the project *is*, read out of the uploaded documents — scope, requirements, resources,
  /// milestones, stakeholders and so on. The Planning Review screen's top panel. Stored on the
  /// snapshot rather than on the project because it is the model's reading at one point in time,
  /// not a fact the PM has confirmed.
  overview            Json     @default("[]") // [{ key, label, summary, points[] }]
  /// What the project still lacks before it can start, each tied where possible to the catalog
  /// document that would close it — this is what the Planning Studio filters its list down to.
  planningGaps        Json     @default("[]") // [{ title, why, documentName, severity }]
  /// Contradictions and anomalies found *between* the uploaded documents, plus limits on the
  /// analysis itself. Kept apart from `risks`, which are risks of the recommended approach.
  findings            Json     @default("[]") // [{ title, detail, evidence }]
  /// RECOMMENDED when the model chose the approach, PM_CHOSEN when it merely scored the PM's own.
  /// The Approach Advisory panel is read-only in the second case — there is nothing to switch to.
  approachMode        String   @default("RECOMMENDED")
  /// Which writer produced this snapshot: "anthropic" or "mock". The AI call falls back to the
  /// deterministic mock on any error, so without this a heuristic result is indistinguishable
  /// from a real one — both to the PM and to anyone auditing the decision later.
  aiProvider          String   @default("mock") // [{ fieldKey, label, value }] proposed, unverified
  createdAt           DateTime @default(now())

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFile ReferenceFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  decisions  ApproachDecision[]

  @@index([projectId, createdAt])
  @@map("ai_approach_suggestions")
}

/// The PM decision gate. Confirming locks the generation contract for the pack.
model ApproachDecision {
  id             String          @id @default(uuid())
  projectId      String
  evaluationId   String?
  approach       String // the confirmed governance model code (or PM-overridden value)
  outcome        DecisionOutcome @default(CONFIRMED)
  rigor          String          @default("Standard+")
  rationale      String?
  operatingModel Json?
  documentPack   Json // required[] + conditional[] frozen at confirmation time
  active         Boolean         @default(true)
  decidedById    String
  decidedAt      DateTime        @default(now())

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluation AiApproachSuggestion? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  decidedBy  User                  @relation(fields: [decidedById], references: [id])

  @@index([projectId, active])
  @@map("approach_decisions")
}

// ---------------------------------------------------------------- flow 3: templates, generate, approve

/// Catalog of planning outputs, selected by project type + domain. Six of these
/// (Project Charter, Organization Chart, RACI Matrix, Communication Plan,
/// Change / Escalation Flow, Risk Plan — see data/document-catalog.ts) are required
/// for every project regardless of the confirmed governance model; only their
/// internal structure changes by model, via data/governance-models.ts.
model DocumentDefinition {
  id           String           @id @default(uuid())
  projectType  ProjectType
  domain       ManagementDomain
  name         String
  requirement  Requirement      @default(REQUIRED)
  conditionKey String? // e.g. "budgetControlScope=PM owns"
  description  String?
  order        Int              @default(0)

  templates DocumentTemplate[]
  documents PlanningDocument[]

  @@unique([projectType, domain, name])
  @@map("document_definitions")
}

/// Three PMBOK-aligned product templates per document: standard | lean | delivery.
model DocumentTemplate {
  id           String  @id @default(uuid())
  definitionId String
  key          String // standard | lean | delivery
  name         String
  subtitle     String?
  description  String?
  recommended  Boolean @default(false)
  fitScore     Int     @default(80)
  sections     Json // [{ title, hint, required, defaultIncluded }]

  definition DocumentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  documents  PlanningDocument[]

  @@unique([definitionId, key])
  @@map("document_templates")
}

model PlanningDocument {
  id            String           @id @default(uuid())
  projectId     String
  definitionId  String
  templateId    String?
  name          String
  domain        ManagementDomain
  requirement   Requirement      @default(REQUIRED)
  status        DocumentStatus   @default(NOT_GENERATED)
  version       Int              @default(1)
  coverage      Int              @default(0)
  sourceTrace   Json? // inputs and recommendation used for this draft
  structuredData Json? // e.g. RACI table rows, risk register rows — used for .docx tables and the dashboard export
  generatedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  pmQuestions   Json             @default("[]")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition DocumentDefinition @relation(fields: [definitionId], references: [id])
  template   DocumentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  approvedBy User?              @relation("documentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  sections   DocumentSection[]

  @@unique([projectId, definitionId])
  @@index([projectId, status])
  @@map("planning_documents")
}

/// The generation contract: only included sections are written by the agent.
model DocumentSection {
  id         String  @id @default(uuid())
  documentId String
  title      String
  hint       String?
  required   Boolean @default(false)
  included   Boolean @default(true)
  order      Int     @default(0)
  content    String?
  custom     Boolean @default(false)

  document PlanningDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, order])
  @@map("document_sections")
}

// ---------------------------------------------------------------- dashboard, audit, agent

/// PM action center entries — "AI prepares; the PM decides".
model ActionItem {
  id            String           @id @default(uuid())
  projectId     String
  priority      ActionPriority   @default(REQUIRED)
  domain        ManagementDomain @default(GOVERNANCE)
  title         String
  description   String?
  targetView    String           @default("input") // input | approach | studio
  /// The catalog document this action is about, so "Open" lands on *that* document in the Studio
  /// rather than on whatever the Studio would have selected by itself. Null when the gap names no
  /// document, or names one the catalog does not hold — then `targetView` is "input".
  ///
  /// Deliberately its own column rather than reusing `suggestions[0]`: a suggestion is an answer
  /// offered to the PM, and overloading it with a navigation target means one of the two silently
  /// breaks the next time either is changed.
  targetDocument String?
  suggestions   String[]         @default([])
  status        ActionStatus     @default(OPEN)
  resolvedValue String?
  blocksDocument String?
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("action_items")
}

model PlanningTask {
  id        String    @id @default(uuid())
  projectId String
  title     String
  detail    String?
  state     TaskState @default(TODO)
  order     Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("planning_tasks")
}

model DomainReadiness {
  id        String           @id @default(uuid())
  projectId String
  domain    ManagementDomain
  score     Int              @default(0)
  target    Int              @default(80)
  updatedAt DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, domain])
  @@map("domain_readiness")
}

model AuditEvent {
  /// Null for a platform-level event that belongs to no single project — a customer reference
  /// library change, say. Project activity feeds filter on projectId, so they are unaffected.
  id        String    @id @default(uuid())
  projectId String?
  actorType ActorType @default(PM)
  actorId   String?
  type      String // INPUT_VERIFIED, APPROACH_CONFIRMED, DOCUMENT_GENERATED...
  title     String
  detail    String?
  payload   Json?
  createdAt DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("audit_events")
}

/// One chat thread, scoped to a project AND a user: chats are private to whoever held them,
/// the same way project access is. `title` is derived from the first question asked.
model AgentSession {
  id        String   @id @default(uuid())
  projectId String
  userId    String?
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AgentMessage[]

  @@index([projectId, userId, updatedAt])
  @@map("agent_sessions")
}

model AgentMessage {
  id        String    @id @default(uuid())
  projectId String
  /// Null only for rows created before chat sessions existed.
  sessionId String?
  role      AgentRole
  content   String
  meta      Json? // recommendation reasons, verified inputs, suggested actions
  createdAt DateTime  @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([sessionId, createdAt])
  @@map("agent_messages")
}

model DashboardLayout {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  widgets   Json // { readiness: true, approach: true, ... }
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("dashboard_layouts")
}

model ExportJob {
  id          String   @id @default(uuid())
  projectId   String
  format      String // DOCX | XLSX | PDF | CONFLUENCE
  status      String   @default("QUEUED")
  includeOnly String   @default("APPROVED") // approved baseline only, by policy
  fileKey     String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("export_jobs")
}

// ---------------------------------------------------------------- customer reference library
//
// A customer's own checklists and document templates, uploaded once and reused by every project
// for that customer — the alternative to re-uploading the same LGCNS/SKAX checklist into each new
// workspace. Nothing here is retrieved by similarity: a project resolves to exactly one Customer
// by name, and a template is looked up by (customer, documentType). That is a key lookup, so
// there is no vector store, and adding more templates only adds rows.
//
// Managed by PROGRAM_OWNER and ADMIN. Project owners read it but never write it.

/// One customer organisation. `key` is the stable slug the code refers to; `aliases` are the
/// spellings a PM may actually type into the project's free-text Customer field ("SK AX",
/// "SK C and C", "AGS"), which is how a project is matched to this library — see
/// lib/customer-match.ts. The Customer field stays free text on purpose: new customers arrive
/// without anyone having to add a dropdown option first.
model Customer {
  id             String   @id @default(uuid())
  key            String   @unique // SKAX | LGCNS | ...
  name           String
  aliases        String[] // other spellings that resolve to this customer
  logoStorageKey String?
  logoFileName   String?
  logoMimeType   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  checklists CustomerChecklist[]
  templates  CustomerTemplate[]

  @@map("customers")
}

/// One uploaded checklist file (LGCNS's .xlsx intake checklist, SKAX's .docx operational
/// readiness checklist) plus the rows parsed out of it. Versioned rather than overwritten:
/// a project assessed against v1 must stay explainable after v2 lands.
model CustomerChecklist {
  id         String   @id @default(uuid())
  customerId String
  name       String
  sourceFile String // the file name as the uploader saw it, in its own language
  storageKey String
  mimeType   String
  version    Int      @default(1)
  active     Boolean  @default(true) // the version projects are assessed against
  parseNote  String? // what the parser did, and what it could not read
  uploadedAt DateTime @default(now())

  customer    Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       ChecklistItem[]
  assessments ProjectChecklistAssessment[]

  @@index([customerId, active])
  @@map("customer_checklists")
}

/// One question from a checklist. Kept close to the source: the parser does not interpret or
/// translate, so a Korean checklist stays Korean and the PM can see it is the same document.
model ChecklistItem {
  id          String  @id @default(uuid())
  checklistId String
  order       Int
  section     String? // the source's grouping column (구분 / area heading)
  code        String? // item number, when the source had one
  text        String // the check itself (체크사항)
  guidance    String? // the source's note column (비고)
  expected    String? // a model answer, where the source shipped one (답변)

  /// English renderings, written once when the checklist is uploaded. The application's interface
  /// is English, so the screen reads these; the original columns above are kept and shown beneath
  /// them, because the customer's audit quotes the Korean and a translation cannot be searched for
  /// in their file. Null when the source is already English, or when no model was available to
  /// translate — the UI then shows the original alone rather than an empty line.
  textEn      String?
  sectionEn   String?
  guidanceEn  String?

  checklist   CustomerChecklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assessments ChecklistAssessmentItem[]

  @@index([checklistId, order])
  @@map("checklist_items")
}

/// How one project stands against one checklist item.
enum ChecklistStatus {
  MET
  PARTIAL
  NOT_MET
  /// The customer's own document puts this out of scope (AGS's 범위 외), or the PM ruled it out.
  /// Excluded from the denominator — scoring a project down for a question that does not apply
  /// to it would make the number meaningless.
  NOT_APPLICABLE
  /// Nothing has assessed this yet. Deliberately distinct from NOT_MET: "we have not looked" and
  /// "we looked and it is missing" must never read the same to a PM.
  UNKNOWN
}

/// Who decided a status. A PM decision outranks both machines and is never overwritten by a re-run.
enum AssessmentSource {
  DETERMINISTIC
  AI
  PM
}

/// One project measured against one customer checklist.
///
/// This is what makes readiness mean something customer-specific: instead of "how much of our own
/// form is filled in", it is "how much of what *this customer* requires can we evidence". The
/// assessment is re-run as documents are approved, and it only ever re-examines items that are
/// not already MET — an approved document can add evidence, never remove it, so the work (and the
/// token cost) shrinks as the project matures.
model ProjectChecklistAssessment {
  id          String   @id @default(uuid())
  projectId   String
  checklistId String
  /// 0-100 over the applicable items. Denormalised so program roll-ups do not re-derive it.
  score       Int      @default(0)
  /// An input or an approved document changed after this ran, so the score may be understated.
  stale       Boolean  @default(false)
  /// IDLE | RUNNING | ERROR — a re-assessment runs outside the request that triggered it, so the
  /// UI needs to see that one is in flight and whether the last one failed.
  runState    String   @default("IDLE")
  lastError   String?
  /// `anthropic` or `none`. Without a provider the AI pass does not run and items stay UNKNOWN —
  /// there is no mock fallback here on purpose, the same reasoning as Skill 0: a guessed "MET"
  /// in front of a PM is worse than an honest blank.
  aiProvider  String   @default("none")
  assessedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklist CustomerChecklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  items     ChecklistAssessmentItem[]

  @@unique([projectId, checklistId])
  @@index([projectId])
  @@map("project_checklist_assessments")
}

model ChecklistAssessmentItem {
  id              String           @id @default(uuid())
  assessmentId    String
  checklistItemId String
  status          ChecklistStatus  @default(UNKNOWN)
  source          AssessmentSource @default(DETERMINISTIC)
  /// What the status rests on — a verified input, a document section, a PM's own words. Shown
  /// next to the status, because a score nobody can audit is not evidence of readiness.
  evidence        String?
  note            String?
  updatedAt       DateTime         @updatedAt

  assessment ProjectChecklistAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  item       ChecklistItem              @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, checklistItemId])
  @@index([assessmentId, status])
  @@map("checklist_assessment_items")
}

/// A customer's own file for one document type — e.g. SKAX's kickoff .pptx. Kept as the original
/// binary so generation can fill it in place (unzip, replace the placeholder runs, rezip) and
/// preserve the customer's layout, fonts and masters rather than re-drawing them.
model CustomerTemplate {
  id           String   @id @default(uuid())
  customerId   String
  documentType String // "Kickoff Deck" — matched against the document catalog later
  fileType     String // PPTX | DOCX | XLSX
  sourceFile   String
  storageKey   String
  mimeType     String
  version      Int      @default(1)
  active       Boolean  @default(true)
  /// What the parser found to fill: [{ token, occurrences, locations, splitAcrossRuns }].
  placeholders Json
  parseNote    String?
  uploadedAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, documentType, version])
  @@index([customerId, active])
  @@map("customer_templates")
}
