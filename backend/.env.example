# --- Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database
DATABASE_URL="postgresql://nextpm:nextpm@localhost:5432/nextpm?schema=public"

# --- Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# --- File references (optional uploads used only to prefill/verify inputs)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
MAX_FILES_PER_GROUP=2

# --- Planning agent
# NEVER put a real key in this file: it is a template and it IS tracked by git.
# Copy it to backend/.env (git-ignored) and fill the key there.
AI_PROVIDER=mock                 # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5    # optional; this is also the built-in default
# How hard the model thinks. The API default is `high`; this app defaults to `medium`, which on
# this workload costs less for near-identical output. Use `off` for a model that rejects effort
# (Haiku 4.5, older Sonnet) — sending it there would 400 and silently fall back to the mock writer.
AI_EFFORT=medium                 # low | medium | high | xhigh | max | off
