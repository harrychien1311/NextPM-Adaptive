# --- Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database
DATABASE_URL="postgresql://nextpm:nextpm@localhost:5432/nextpm?schema=public"

# --- Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# --- File references (optional uploads used only to prefill/verify inputs)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
MAX_FILES_PER_GROUP=2

# --- Planning agent (leave empty to use the deterministic mock generator)
AI_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
